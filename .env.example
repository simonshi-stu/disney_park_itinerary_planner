# Copy this file to .env locally, then replace the placeholder values.
# Never commit .env and never paste real keys into this example file.

DEEPSEEK_API_KEY=replace-with-a-new-key
DEEPSEEK_MODEL=deepseek-chat
# Optional; the default is https://api.deepseek.com
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Only needed for fully automatic GPT API review.
# OPENAI_API_KEY=replace-with-openai-key
# OPENAI_MODEL=replace-with-a-review-model
# OPENAI_BASE_URL=https://api.openai.com/v1
