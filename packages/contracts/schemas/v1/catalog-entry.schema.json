{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://disney-park-itinerary-planner.local/contracts/v1/catalog-entry.schema.json",
  "title": "Catalog resolver entry v1",
  "description": "Versioned injected catalog record used by the catalog resolver; lifecycle semantics are defined by catalog-attraction-lifecycle.v1.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "operator_id",
    "resort_id",
    "park_id",
    "aliases",
    "canonical_attraction_id",
    "canonical_attraction_name",
    "canonical_category",
    "lifecycle"
  ],
  "properties": {
    "contract_version": { "const": "catalog-entry.v1" },
    "operator_id": { "type": "string", "minLength": 1 },
    "resort_id": { "type": "string", "minLength": 1 },
    "park_id": { "type": "string", "minLength": 1 },
    "aliases": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "canonical_attraction_id": { "type": "string", "minLength": 1 },
    "canonical_attraction_name": { "type": "string", "minLength": 1 },
    "canonical_category": { "type": "string", "enum": ["attraction", "entertainment"] },
    "lifecycle": { "$ref": "catalog-attraction-lifecycle.schema.json" }
  }
}
