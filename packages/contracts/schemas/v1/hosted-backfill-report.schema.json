{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://disney-park-itinerary-planner.local/contracts/v1/hosted-backfill-report.schema.json",
  "title": "Hosted raw backfill report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "run_id",
    "generated_at",
    "status",
    "complete",
    "scope",
    "counts",
    "classification_counts",
    "archives",
    "neon_only",
    "r2_only",
    "hosted_only",
    "replay_parity",
    "failures",
    "next_steps"
  ],
  "properties": {
    "contract_version": { "const": "hosted-backfill-report.v1" },
    "run_id": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "status": { "enum": ["passed", "blocked"] },
    "complete": { "type": "boolean" },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root_scope", "target_label", "bucket", "object_prefix"],
      "properties": {
        "root_scope": { "type": "string" },
        "target_label": { "type": ["string", "null"] },
        "bucket": { "type": ["string", "null"] },
        "object_prefix": { "type": "string" }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["git_archives", "git_raw_observations", "git_normalized_observations", "neon_archives", "r2_objects", "matched_archives"],
      "properties": {
        "git_archives": { "type": "integer", "minimum": 0 },
        "git_raw_observations": { "type": "integer", "minimum": 0 },
        "git_normalized_observations": { "type": "integer", "minimum": 0 },
        "neon_archives": { "type": "integer", "minimum": 0 },
        "r2_objects": { "type": "integer", "minimum": 0 },
        "matched_archives": { "type": "integer", "minimum": 0 }
      }
    },
    "classification_counts": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 },
      "required": ["matched", "git_only", "neon_only", "r2_only", "hosted_only", "hash_mismatch", "count_mismatch", "r2_error"]
    },
    "diagnostic_samples": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sample_limit", "git_archives", "neon_only", "r2_only", "hosted_only", "replay_parity"],
      "properties": {
        "sample_limit": { "type": "integer", "minimum": 1 },
        "git_archives": { "$ref": "#/$defs/sample_counts" },
        "neon_only": { "$ref": "#/$defs/sample_counts" },
        "r2_only": { "$ref": "#/$defs/sample_counts" },
        "hosted_only": { "$ref": "#/$defs/sample_counts" },
        "replay_parity": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["status", "failure_count", "included_failure_count", "omitted_failure_count", "checks"],
              "properties": {
                "status": { "enum": ["passed", "blocked"] },
                "failure_count": { "type": "integer", "minimum": 0 },
                "included_failure_count": { "type": "integer", "minimum": 0 },
                "omitted_failure_count": { "type": "integer", "minimum": 0 },
                "checks": {
                  "type": "object",
                  "additionalProperties": { "$ref": "#/$defs/parity_sample_counts" }
                }
              }
            }
          ]
        }
      }
    },
    "archives": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["raw_archive_id", "sha256", "source_name", "byte_size", "row_count", "normalized_row_count", "classification", "issues"],
        "properties": {
          "raw_archive_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "source_name": { "type": "string", "minLength": 1 },
          "byte_size": { "type": "integer", "minimum": 1 },
          "row_count": { "type": "integer", "minimum": 0 },
          "normalized_row_count": { "type": "integer", "minimum": 0 },
          "classification": { "type": "string" },
          "issues": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "neon_only": { "type": "array", "items": { "type": "object" } },
    "r2_only": { "type": "array", "items": { "type": "object" } },
    "hosted_only": { "type": "array", "items": { "type": "object" } },
    "replay_parity": {
      "type": ["object", "null"],
      "properties": {
        "failure_count": { "type": "integer", "minimum": 0 },
        "diagnostic_sample_limit": { "type": "integer", "minimum": 1 },
        "checks": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/parity_check" }
        },
        "dates": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "mismatch_count": { "type": "integer", "minimum": 0 },
              "mismatches": { "type": "array", "items": { "type": "object" } }
            }
          }
        }
      }
    },
    "failures": { "type": "array", "items": { "type": "object" } },
    "next_steps": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "sample_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total_count", "included_count", "omitted_count"],
      "properties": {
        "total_count": { "type": "integer", "minimum": 0 },
        "included_count": { "type": "integer", "minimum": 0 },
        "omitted_count": { "type": "integer", "minimum": 0 }
      }
    },
    "parity_sample_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mismatch_count", "difference_count", "included_count", "omitted_count"],
      "properties": {
        "mismatch_count": { "type": "integer", "minimum": 0 },
        "difference_count": { "type": "integer", "minimum": 0 },
        "included_count": { "type": "integer", "minimum": 0 },
        "omitted_count": { "type": "integer", "minimum": 0 }
      }
    },
    "parity_check": {
      "type": "object",
      "properties": {
        "passed": { "type": "boolean" },
        "mismatch_count": { "type": "integer", "minimum": 0 },
        "difference_count": { "type": "integer", "minimum": 0 },
        "sample_limit": { "type": "integer", "minimum": 1 },
        "sampled_mismatch_count": { "type": "integer", "minimum": 0 },
        "omitted_mismatch_count": { "type": "integer", "minimum": 0 },
        "mismatches": { "type": "array", "items": { "type": "object" } }
      }
    }
  }
}
