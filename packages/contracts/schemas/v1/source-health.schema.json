{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://disney-park-itinerary-planner.local/contracts/v1/source-health.schema.json",
  "title": "Source health v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "source_health_id",
    "source_name",
    "run_id",
    "envelope_id",
    "source_status",
    "requested_at",
    "ingested_at",
    "record_count",
    "adapter_version",
    "schema_version",
    "fallback_status",
    "hosted_write_status",
    "generated_at"
  ],
  "properties": {
    "contract_version": { "const": "source-health.v1" },
    "source_health_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "source_name": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "envelope_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "source_status": { "enum": ["ok", "stale", "outage"] },
    "requested_at": { "type": "string", "format": "date-time" },
    "observed_at": { "type": ["string", "null"], "format": "date-time" },
    "source_observed_at": { "type": ["string", "null"], "format": "date-time" },
    "ingested_at": { "type": "string", "format": "date-time" },
    "source_age_minutes": { "type": ["number", "null"], "minimum": 0 },
    "payload_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "payload_byte_size": { "type": ["integer", "null"], "minimum": 0 },
    "record_count": { "type": "integer", "minimum": 0 },
    "adapter_version": { "type": "string", "minLength": 1 },
    "schema_version": { "type": "string", "minLength": 1 },
    "error_type": { "type": ["string", "null"] },
    "error_message": { "type": ["string", "null"] },
    "fallback_status": { "enum": ["written", "failed", "not_attempted"] },
    "hosted_write_status": { "enum": ["disabled", "written", "failed", "not_attempted"] },
    "hosted_failure_reason": { "type": ["string", "null"] },
    "hosted_failure_message": { "type": ["string", "null"] },
    "generated_at": { "type": "string", "format": "date-time" }
  }
}
